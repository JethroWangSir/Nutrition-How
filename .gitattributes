* text=auto

# Keep Unity YAML files mergeable and line-ending stable.
*.cs text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf

# Large binary assets must use Git LFS (GitHub's normal file limit is 100 MiB).
*.mp4 filter=lfs diff=lfs merge=lfs -text
